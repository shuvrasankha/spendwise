rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The record is the caller's
    function owns() {
      return signedIn() && request.auth.uid == resource.data.uid;
    }

    // A new record is created as the caller's
    function createsOwn() {
      return signedIn() && request.auth.uid == request.resource.data.uid;
    }

    // An update can't move a record into someone else's account
    function keepsOwner() {
      return request.resource.data.uid == resource.data.uid;
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    match /expenses/{id} {
      allow read, delete: if owns();
      allow create: if createsOwn();
      allow update: if owns() && keepsOwner();
    }

    match /income/{id} {
      allow read, delete: if owns();
      allow create: if createsOwn();
      allow update: if owns() && keepsOwner();
    }

    // A debt can name someone by email (withEmail): they can read it, and only say it's settled
    // (claimDate) or take that back; the sender confirms, which settles it.
    // fromEmail must be the sender's own verified email, so it can't impersonate anyone.
    function validShare(d) {
      return (!('withEmail' in d) && !('fromEmail' in d) && !('fromName' in d))
        || (emailVerified()
          && d.withEmail is string && d.withEmail.size() <= 254
          && d.withEmail == d.withEmail.lower() && d.withEmail != myEmail()
          && d.fromEmail == myEmail()
          && d.fromName is string && d.fromName.size() <= 100);
    }

    match /debts/{id} {
      allow read: if owns()
        || (signedIn() && emailVerified() && resource.data.withEmail == myEmail());
      allow delete: if owns();
      allow create: if createsOwn() && validShare(request.resource.data);
      // Settling and reactivating; who it's shared with stays as it was
      allow update: if (owns() && keepsOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['withEmail', 'fromEmail', 'fromName']))
        || (sharedWithMe() && resource.data.get('settled', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimDate'])
          && (!('claimDate' in request.resource.data)
            || (request.resource.data.claimDate is string
              && request.resource.data.claimDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))));
    }

    function sharedWithMe() {
      return signedIn() && emailVerified() && resource.data.get('withEmail', '') == myEmail();
    }

    // An investment (a fund, an FD, a PPF account): what it's worth now and on which day, and the
    // goal it's for. The money put in is in expenses ('Savings & Investments', with holdingId).
    function validHolding(d) {
      return d.keys().hasOnly(['uid', 'name', 'kind', 'value', 'valueDate', 'goalId', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.kind in ['mf', 'stocks', 'fd', 'rd', 'ppf', 'nps', 'epf', 'gold', 'other']
        && (!('value' in d) || (d.value is number && d.value >= 0))
        && (!('valueDate' in d) || (d.valueDate is string
          && d.valueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('goalId' in d) || (d.goalId is string && d.goalId.size() <= 40));
    }

    match /holdings/{id} {
      allow read, delete: if owns();
      allow create: if createsOwn() && validHolding(request.resource.data);
      allow update: if owns() && keepsOwner() && validHolding(request.resource.data);
    }

    // One doc per user, id = uid:
    // { budget: {total, cats}, goals: [...], remindAt: "HH:MM", remindOn: bool }
    function validSettings(d) {
      return d.keys().hasOnly(['budget', 'goals', 'remindAt', 'remindOn'])
        && (!('remindOn' in d) || d.remindOn is bool)
        && (!('budget' in d) || d.budget is map)
        && (!('goals' in d) || (d.goals is list && d.goals.size() <= 20))
        && (!('remindAt' in d) || (d.remindAt is string
          && d.remindAt.matches('^[0-2][0-9]:[0-5][0-9]$')));
    }

    match /settings/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validSettings(request.resource.data);
    }
  }
}
