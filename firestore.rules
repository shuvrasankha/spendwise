rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // The record is the caller's
    function owns() {
      return signedIn() && request.auth.uid == resource.data.uid;
    }

    // A new record is created as the caller's
    function createsOwn() {
      return signedIn() && request.auth.uid == request.resource.data.uid;
    }

    // An update can't move a record into someone else's account
    function keepsOwner() {
      return request.resource.data.uid == resource.data.uid;
    }

    function ownsCardReference(cardId) {
      return cardId is string && exists(/databases/$(database)/documents/creditCards/$(cardId))
        && get(/databases/$(database)/documents/creditCards/$(cardId)).data.uid == request.auth.uid;
    }

    function ownsCardReferenceAfter(cardId) {
      return cardId is string && existsAfter(/databases/$(database)/documents/creditCards/$(cardId))
        && getAfter(/databases/$(database)/documents/creditCards/$(cardId)).data.uid == request.auth.uid;
    }

    function validExpenseCard(d) {
      return !('creditCardId' in d)
        || (d.payment == 'Credit Card' && ownsCardReferenceAfter(d.creditCardId));
    }

    function validRefundTotal(d) {
      return !('refundedTotal' in d)
        || (d.refundedTotal is number && d.refundedTotal >= 0
          && d.amount is number && d.refundedTotal <= d.amount);
    }

    function keepsRefundedTotal() {
      return request.resource.data.get('refundedTotal', 0) >= resource.data.get('refundedTotal', 0)
        && request.resource.data.get('refundedTotal', 0) <= request.resource.data.amount
        && (resource.data.get('refundedTotal', 0) == 0
          || (request.resource.data.payment == 'Credit Card'
            && request.resource.data.creditCardId == resource.data.creditCardId));
    }

    function validCreditCard(d) {
      return d.keys().hasOnly(['uid', 'name', 'issuer', 'network', 'last4', 'creditLimit',
          'statementDay', 'dueDay', 'active', 'createdAt', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.issuer is string && d.issuer.size() > 0 && d.issuer.size() <= 60
        && (!('network' in d) || d.network in ['', 'Visa', 'Mastercard', 'RuPay', 'Amex', 'Other'])
        && (!('last4' in d) || (d.last4 is string && (d.last4 == '' || d.last4.matches('^[0-9]{4}$'))))
        && (!('creditLimit' in d) || (d.creditLimit is number && d.creditLimit >= 0))
        && (!('statementDay' in d) || (d.statementDay is int && d.statementDay >= 1 && d.statementDay <= 31))
        && (!('dueDay' in d) || (d.dueDay is int && d.dueDay >= 1 && d.dueDay <= 31))
        && (!('active' in d) || d.active is bool);
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    match /expenses/{id} {
      allow read: if owns();
      allow delete: if owns() && resource.data.get('refundedTotal', 0) == 0;
      allow create: if createsOwn() && validExpenseCard(request.resource.data) && validRefundTotal(request.resource.data);
      allow update: if owns() && keepsOwner()
        && validExpenseCard(request.resource.data) && validRefundTotal(request.resource.data) && keepsRefundedTotal();
    }

    match /creditCards/{id} {
      allow read: if owns();
      allow create: if createsOwn() && validCreditCard(request.resource.data);
      allow update: if owns() && keepsOwner() && validCreditCard(request.resource.data);
      allow delete: if false;
    }

    match /cardPayments/{id} {
      allow read: if owns();
      allow create: if createsOwn()
        && request.resource.data.keys().hasOnly(['uid', 'creditCardId', 'statementId', 'amount',
          'paymentDate', 'paymentType', 'idempotencyKey', 'createdAt'])
        && ownsCardReferenceAfter(request.resource.data.creditCardId)
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.paymentDate is string
        && request.resource.data.paymentDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.paymentType in ['full_statement', 'full_current_outstanding']
        && request.resource.data.idempotencyKey == id
        && (!('statementId' in request.resource.data) || request.resource.data.statementId is string);
      allow update: if owns() && keepsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
        && request.resource.data.creditCardId == resource.data.creditCardId
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.idempotencyKey == id;
      allow delete: if false;
    }

    match /cardRefunds/{id} {
      allow read: if owns();
      allow create: if createsOwn()
        && request.resource.data.keys().hasOnly(['uid', 'creditCardId', 'originalExpenseId',
          'amount', 'refundDate', 'description', 'createdAt'])
        && ownsCardReferenceAfter(request.resource.data.creditCardId)
        && request.resource.data.originalExpenseId is string
        && existsAfter(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId))
        && getAfter(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId)).data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId)).data.payment == 'Credit Card'
        && getAfter(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId)).data.creditCardId == request.resource.data.creditCardId
        && request.resource.data.amount is number && request.resource.data.amount > 0
        && request.resource.data.amount <= getAfter(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId)).data.amount
        && request.resource.data.refundDate is string
        && request.resource.data.refundDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.description is string
        && (getAfter(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId)).data.get('refundedTotal', 0)
          >= ((exists(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId))
            ? get(/databases/$(database)/documents/expenses/$(request.resource.data.originalExpenseId)).data.get('refundedTotal', 0) : 0)
            + request.resource.data.amount));
      allow update: if owns() && keepsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdAt'])
        && request.resource.data.creditCardId == resource.data.creditCardId
        && request.resource.data.originalExpenseId == resource.data.originalExpenseId
        && request.resource.data.amount == resource.data.amount;
      allow delete: if false;
    }

    match /income/{id} {
      allow read, delete: if owns();
      allow create: if createsOwn();
      allow update: if owns() && keepsOwner();
    }

    // A debt can name someone by email (withEmail): they can read it, and only say what was paid
    // (claimDate, and claimAmount: part or all of it) or take that back; the sender confirms, which
    // records the payment.
    // fromEmail must be the sender's own verified email, so it can't impersonate anyone.
    function validShare(d) {
      return (!('withEmail' in d) && !('fromEmail' in d) && !('fromName' in d))
        || (emailVerified()
          && d.withEmail is string && d.withEmail.size() <= 254
          && d.withEmail == d.withEmail.lower() && d.withEmail != myEmail()
          && d.fromEmail == myEmail()
          && d.fromName is string && d.fromName.size() <= 100);
    }

    match /debts/{id} {
      allow read: if owns()
        || (signedIn() && emailVerified() && resource.data.withEmail == myEmail());
      allow delete: if owns();
      allow create: if createsOwn() && validShare(request.resource.data);
      // Settling and reactivating; who it's shared with stays as it was
      allow update: if (owns() && keepsOwner()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['withEmail', 'fromEmail', 'fromName']))
        || (sharedWithMe() && resource.data.get('settled', false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimDate', 'claimAmount'])
          && (!('claimDate' in request.resource.data)
            || (request.resource.data.claimDate is string
              && request.resource.data.claimDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && (!('claimAmount' in request.resource.data)
            || (request.resource.data.claimAmount is number && request.resource.data.claimAmount > 0
              && request.resource.data.claimAmount <= resource.data.amount)));
    }

    function sharedWithMe() {
      return signedIn() && emailVerified() && resource.data.get('withEmail', '') == myEmail();
    }

    // An investment (a fund, an FD, a PPF account): what it's worth now and on which day, and the
    // goal it's for. The money put in is in expenses ('Savings & Investments', with holdingId).
    function validHolding(d) {
      return d.keys().hasOnly(['uid', 'name', 'kind', 'value', 'valueDate', 'goalId', 'createdAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.kind in ['mf', 'stocks', 'fd', 'rd', 'ppf', 'nps', 'epf', 'gold', 'other']
        && (!('value' in d) || (d.value is number && d.value >= 0))
        && (!('valueDate' in d) || (d.valueDate is string
          && d.valueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (!('goalId' in d) || (d.goalId is string && d.goalId.size() <= 40));
    }

    match /holdings/{id} {
      allow read, delete: if owns();
      allow create: if createsOwn() && validHolding(request.resource.data);
      allow update: if owns() && keepsOwner() && validHolding(request.resource.data);
    }

    // One doc per user, id = uid:
    // { budget: {total, cats}, goals: [...], remindAt: "HH:MM", remindOn: bool,
    //   notif: { seen: [ids], cleared: [ids] } }
    function validSettings(d) {
      return d.keys().hasOnly(['budget', 'goals', 'remindAt', 'remindOn', 'notif'])
        && (!('notif' in d) || (d.notif is map && d.notif.keys().hasOnly(['seen', 'cleared'])
          && (!('seen' in d.notif) || (d.notif.seen is list && d.notif.seen.size() <= 200))
          && (!('cleared' in d.notif) || (d.notif.cleared is list && d.notif.cleared.size() <= 200))))
        && (!('remindOn' in d) || d.remindOn is bool)
        && (!('budget' in d) || d.budget is map)
        && (!('goals' in d) || (d.goals is list && d.goals.size() <= 20))
        && (!('remindAt' in d) || (d.remindAt is string
          && d.remindAt.matches('^[0-2][0-9]:[0-5][0-9]$')));
    }

    match /settings/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validSettings(request.resource.data);
    }
  }
}
